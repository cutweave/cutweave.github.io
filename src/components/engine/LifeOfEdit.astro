---
// SPDX-License-Identifier: GPL-3.0-or-later
/**
 * LifeOfEdit: steps one command, clip.split, from a client to the screen.
 * Facts: arch §5.1 (envelope, typed errors), §5.2 (Tx, patches, snapshots), §8 (render). Status as of product HEAD 7728d7c.
 * Without JS every step is shown. With JS, Previous and Next step through, one detail at a time.
 * Message shapes are real (docs/reference/rpc.md, schema/patch-fixtures.json in the product repo); IDs and revisions are invented.
 * Props: none.
 */
import '../../styles/area-s2.css';
import StatusChip from '../ui/StatusChip.astro';

const steps: { title: string; text: string; code: string; status: 'built' | 'in-progress'; chip?: string }[] = [
  {
    title: 'Validate',
    status: 'built',
    text: 'The client sends the command over JSON-RPC, or an agent calls the matching MCP tool. params._meta carries a request_id, which every change needs, and optionally the expected_rev the client last saw. The engine checks the arguments against the JSON Schema, then runs semantic checks, such as whether the clip exists and the time falls strictly inside it. The actor comes from the credential, not from anything the client claims.',
    code: `{"jsonrpc":"2.0","id":7,"method":"clip.split",
 "params":{"item":"itm_…","at":"4s",
           "_meta":{"request_id":"0190f5c2-…","expected_rev":41}}}`,
  },
  {
    title: 'Tx records forward and inverse patches',
    status: 'built',
    text: 'The command runs inside a transaction. The Tx records the forward patch ops with the values they replace, so each can be inverted (RFC 6902, addressed by ID). A gesture, such as a drag, and a proposal, which is an agent turn, are transaction kinds that still commit as one undo step.',
    code: `forward:  replace …/items/itm_a/duration   7056000000 → 2822400000
          add     …/items/itm_b            // the right half
inverse:  remove  …/items/itm_b
          replace …/items/itm_a/duration   2822400000 → 7056000000`,
  },
  {
    title: 'A new snapshot revision',
    status: 'built',
    text: 'One writer owns the project document. It writes the commit to the journal, applies the patch and publishes an immutable snapshot at the next revision. Readers hold an Arc to a revision, so the hot path takes no locks.',
    code: `rev 41  →  rev 42   // earlier snapshots stay valid for readers`,
  },
  {
    title: 'Event: doc.patched',
    status: 'built',
    text: 'The engine streams the change to every subscriber, with the revision, the one before it, who made it and the patch ops.',
    code: `{"method":"doc.patched",
 "params":{"rev":42,"prev_rev":41,"committed_rev":42,
           "actor":"agent:mcp","tx_id":"tx_9","cause":"command",
           "request_id":"0190f5c2-…","ops":[…]}}`,
  },
  {
    title: 'UI projection updates',
    status: 'built',
    text: 'The editor keeps a read-only mirror of the document. If an event continues from its revision it applies the ops, and if it missed one it fetches a fresh snapshot. It never writes to the mirror directly, and any other client can follow the same stream.',
    code: `if (prev_rev === mirror.rev) applyPatch(mirror, ops)   // @cutweave/protocol
else resync()                                          // project.snapshot`,
  },
  {
    title: 'Render',
    status: 'in-progress',
    chip: 'Wiring pending',
    text: 'Rendering is a pure function of the snapshot, the sequence, the time and the quality. The same revision gives the same frame, so frames can be cached. The compositor and the frame readback are built and tested on synthetic test cards. They are not wired to the engine yet, and nothing decodes real video.',
    code: `render(snapshot@42, sequence, t, quality) → frame`,
  },
];
---
<div class="life" data-life>
  <div class="controls" data-controls hidden>
    <button type="button" class="btn" data-prev>Previous step</button>
    <button type="button" class="btn" data-next>Next step</button>
    <p class="pos" role="status" aria-live="polite" data-pos></p>
  </div>

  <ol class="steps">
    {steps.map((s, i) => (
      <li data-step={i}>
        <span class="n" aria-hidden="true">{i + 1}</span>
        <div class="c">
          <div class="st">
            <h3>{s.title}</h3>
            <StatusChip status={s.status} {...(s.chip ? { label: s.chip } : {})} />
          </div>
          <div class="detail">
            <p>{s.text}</p>
            <pre tabindex="0"><code>{s.code}</code></pre>
          </div>
        </div>
      </li>
    ))}
  </ol>

  <div class="envelope">
    <h3>What protects a retry or a race</h3>
    <ul>
      <li><code>request_id</code> makes a command idempotent. A repeat inside 10 minutes by the same actor, with the same method and parameters, returns the original result, so a client can resend after an engine restart.</li>
      <li><code>expected_rev</code> is optimistic concurrency. If the document has moved on, the command fails with <code>conflict</code> and the current revision instead of overwriting.</li>
      <li>Errors are typed: <code>not_found</code>, <code>locked</code>, <code>conflict</code>, <code>invalid</code> (with a JSON Pointer to the bad parameter), <code>forbidden</code>, <code>unsupported</code> and <code>internal</code>, each with a human message.</li>
    </ul>
    <p class="foot">The message shapes are real, from the JSON-RPC reference and the engine’s generated patch fixtures. IDs, revisions and the request id are invented.</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-life]').forEach((root) => {
    const controls = root.querySelector<HTMLElement>('[data-controls]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const pos = root.querySelector<HTMLElement>('[data-pos]');
    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
    if (!controls || !prev || !next || !pos || steps.length === 0) return;
    controls.hidden = false;
    root.classList.add('js');
    let i = 0;
    const show = (n: number) => {
      i = Math.max(0, Math.min(steps.length - 1, n));
      steps.forEach((s, k) => {
        s.classList.toggle('active', k === i);
        if (k === i) s.setAttribute('aria-current', 'step');
        else s.removeAttribute('aria-current');
      });
      prev.disabled = i === 0;
      next.disabled = i === steps.length - 1;
      pos.textContent = `Step ${i + 1} of ${steps.length}: ${steps[i]?.querySelector('h3')?.textContent ?? ''}`;
    };
    prev.addEventListener('click', () => show(i - 1));
    next.addEventListener('click', () => show(i + 1));
    steps.forEach((s, k) => s.addEventListener('click', () => show(k)));
    show(0);
  });
</script>

<style>
  .life { display: flex; flex-direction: column; gap: var(--space-6); }
  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .controls[hidden] { display: none; }
  .btn {
    height: var(--button-height-md);
    padding-inline: var(--space-4);
    border: var(--border-thin) solid var(--border-control);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: var(--text-body-size);
    font-weight: 600;
    cursor: pointer;
  }
  .btn:hover { background: var(--surface-3); }
  .btn:disabled { color: var(--text-disabled); border-color: var(--border-subtle); cursor: not-allowed; background: var(--surface-2); }
  .pos { color: var(--text-secondary); font-size: 15px; }

  .steps { display: flex; flex-direction: column; gap: var(--space-3); }
  .steps li {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border: var(--border-thin) solid var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
  }
  .n {
    flex: none;
    width: var(--space-8);
    height: var(--space-8);
    display: inline-grid;
    place-items: center;
    border: var(--border-thin) solid var(--border-control);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }
  .c { min-width: 0; display: flex; flex-direction: column; gap: var(--space-2); flex: 1; }
  .st { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); }
  h3 { font-size: var(--display-card-size); line-height: 28px; font-weight: 650; }
  .detail { display: flex; flex-direction: column; gap: var(--space-3); color: var(--text-secondary); font-size: 15px; line-height: 23px; max-width: var(--prose-max); }
  pre {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border: var(--border-thin) solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-1);
    color: var(--text-primary);
    font-size: var(--mono-small);
    line-height: var(--code-line);
    overflow-x: auto;
  }

  /* With JS: one detail at a time. The marigold marks the current step ("here"). */
  .js .steps li { cursor: pointer; }
  .js .steps li:not(.active) .detail { display: none; }
  .js .steps li:not(.active) { background: var(--surface-1); }
  .js .steps li:not(.active) h3 { color: var(--text-secondary); font-weight: 500; }
  .js .steps li.active { border-color: var(--marigold-text); }
  .js .steps li.active .n { border-color: var(--marigold-text); background: var(--marigold-subtle); color: var(--text-primary); }

  .envelope {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border: var(--border-thin) solid var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
  }
  .envelope ul { display: flex; flex-direction: column; gap: var(--space-2); color: var(--text-secondary); }
  .envelope code { font-size: var(--mono-small); color: var(--text-primary); }
  .foot { color: var(--text-muted); font-size: 14px; }
</style>
