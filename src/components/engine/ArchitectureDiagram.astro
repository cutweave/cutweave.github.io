      { d: 'M180 116 V139', head: [180, 146, 'd'], paths: ALL },
      { d: 'M180 224 V241', head: [180, 248, 'd'], paths: ALL },
      { d: 'M180 288 V305', head: [180, 312, 'd'], paths: ALL },
      { d: 'M180 352 V369', head: [180, 376, 'd'], paths: ALL },
      { d: 'M180 416 V454', paths: ALL },
      { d: 'M66 454 H294', paths: ALL },
      { d: 'M66 454 V469', head: [66, 476, 'd'], paths: 'ui plugins' },
      { d: 'M180 454 V469', head: [180, 476, 'd'], paths: 'cli' },
