// SPDX-License-Identifier: GPL-3.0-or-later
/**
 * ArchitectureDiagram: one engine, many clients. Inline SVG drawn from docs/content-inventory.md §8.1
 * (arch §1, §2). Clients on top, the API layer, the engine (command bus, Tx, project document,
 * render and audio, plus media, jobs, AI gateway and plugin host) and the outputs.
 *
 * Props:
 *  - compact?: boolean    simplified diagram (clients, one engine chain, outputs) for the landing page.
 *                         Default false. Compact omits the API layer detail and the engine services.
 *  - idPrefix?: string    unique id prefix when two diagrams share a page (default 'arch-full' or 'arch-compact')
 *  - headingLevel?: 3|4   not used for headings; the component has none. Place it under your own heading.
 *
 * Behavior: four buttons trace a client's path (click to pin, hover or focus to preview). Hovering a
 * client box in the SVG does the same. Without JS the whole diagram is shown. Two SVGs are rendered
 * (wide and narrow) and CSS shows one: the narrow one is a vertical stack for phones, so text stays
 * readable at 360 px with no horizontal scroll.
 */
import '../../styles/area-s2.css';

interface Props {
  compact?: boolean;
  idPrefix?: string;
}
const { compact = false, idPrefix } = Astro.props;
const pre = idPrefix ?? (compact ? 'arch-compact' : 'arch-full');

type Dir = 'u' | 'd' | 'l' | 'r';
interface Node { id: string; kind: 'client' | 'api' | 'core' | 'svc' | 'out'; x: number; y: number; w: number; h: number; title: string; sub?: string; mono?: boolean; paths: string; client?: string; agent?: boolean }
interface Box { x: number; y: number; w: number; h: number; label: string; lx: number; ly: number }
interface Edge { d: string; head?: [number, number, Dir]; paths: string; dashed?: boolean }
interface Label { x: number; y: number; text: string; anchor?: 'start' | 'end'; mono?: boolean; paths: string }
interface Layout { w: number; h: number; boxes: Box[]; nodes: Node[]; edges: Edge[]; labels: Label[]; small: boolean }

const ALL = 'ui agents cli plugins';
const none = 'x'; // not on any client's path: dimmed whenever a client is selected

const clientsWide = (): Node[] => [
  { id: 'ui', kind: 'client', client: 'ui', x: 15, y: 16, w: 210, h: 60, title: 'Desktop UI', sub: 'Electron and React', paths: 'ui' },
  { id: 'agents', kind: 'client', client: 'agents', x: 255, y: 16, w: 210, h: 60, title: 'AI agents', sub: 'MCP, stdio or HTTP', paths: 'agents', agent: true },
  { id: 'cli', kind: 'client', client: 'cli', x: 495, y: 16, w: 210, h: 60, title: 'cutweave CLI', sub: 'JSON in, JSON out', paths: 'cli' },
  { id: 'plugins', kind: 'client', client: 'plugins', x: 735, y: 16, w: 210, h: 60, title: 'Plugins', sub: 'WASM, JS, WGSL, UI panels', paths: 'plugins' },
];
const clientsNarrow = (): Node[] => [
  { id: 'ui', kind: 'client', client: 'ui', x: 12, y: 12, w: 162, h: 48, title: 'Desktop UI', sub: 'Electron and React', paths: 'ui' },
  { id: 'agents', kind: 'client', client: 'agents', x: 186, y: 12, w: 162, h: 48, title: 'AI agents', sub: 'MCP', paths: 'agents', agent: true },
  { id: 'cli', kind: 'client', client: 'cli', x: 12, y: 68, w: 162, h: 48, title: 'cutweave CLI', sub: 'JSON in, JSON out', paths: 'cli' },
  { id: 'plugins', kind: 'client', client: 'plugins', x: 186, y: 68, w: 162, h: 48, title: 'Plugins', sub: 'WASM, JS, WGSL', paths: 'plugins' },
];

