      { id: 'tx', kind: 'core', x: 345, y: 330, w: 230, h: 56, title: 'Transaction (Tx)', sub: 'forward and inverse patches', paths: ALL },
      { id: 'doc', kind: 'core', x: 635, y: 330, w: 280, h: 56, title: 'Project document', sub: 'immutable snapshots, one writer', paths: ALL },
      { id: 'plug', kind: 'svc', x: 45, y: 430, w: 230, h: 56, title: 'Plugin host', sub: 'wasmtime, QuickJS, WGSL', paths: 'plugins' },
      { id: 'jobs', kind: 'svc', x: 295, y: 430, w: 230, h: 56, title: 'Job manager', sub: 'export, analysis, AI, proxies', paths: 'cli' },
