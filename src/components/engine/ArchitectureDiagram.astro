const wide = compact ? compactWide() : fullWide();
const narrow = compact ? compactNarrow() : fullNarrow();
const layouts = [
  { key: 'wide', l: wide },
  { key: 'narrow', l: narrow },
];

const headPoints = ([x, y, dir]: [number, number, Dir]): string => {
  const s = 7;
  const h = 4;
  if (dir === 'd') return `${x},${y} ${x - h},${y - s} ${x + h},${y - s}`;
  if (dir === 'u') return `${x},${y} ${x - h},${y + s} ${x + h},${y + s}`;
  if (dir === 'r') return `${x},${y} ${x - s},${y - h} ${x - s},${y + h}`;
  return `${x},${y} ${x + s},${y - h} ${x + s},${y + h}`;
};

const titleY = (n: Node) => (n.sub ? n.y + n.h * 0.46 : n.y + n.h / 2 + 5);
const subY = (n: Node) => n.y + n.h * 0.76;

const clients = [
  {
    id: 'ui',
    label: 'Desktop UI',
    trace: 'Desktop UI: commands over JSON-RPC on a WebSocket, media over HTTP, preview frames through a shared-memory ring. Then command bus, Tx, project document, render pipeline and audio engine, out to the preview.',
  },
  {
    id: 'agents',
    label: 'AI agents',
    trace: 'AI agents: MCP over stdio or HTTP. Then command bus, Tx and project document. Image tools come from the render pipeline as an agent frame.',
  },
  {
    id: 'cli',
    label: 'CLI',
    trace: 'CLI: JSON in, JSON out. It attaches to the running engine or starts a headless one, and goes through the same command bus. Export runs as a job through the render pipeline.',
  },
  {
    id: 'plugins',
    label: 'Plugins',
    trace: 'Plugins: run in the plugin host (wasmtime, QuickJS, a WGSL loader), which calls the command bus and the render pipeline. A plugin effect shows up in the preview.',
  },
];
const defaultTrace = 'Select a client to trace its path through the engine.';
const titleId = `${pre}-title`;
const descId = `${pre}-desc`;
---
<figure class:list={['arch', compact && 'is-compact']} data-arch data-default={defaultTrace}>
  <div class="tracer" role="group" aria-label="Trace a client's path">
    <span class="tracer-label">Trace a path</span>
    <div class="tracer-buttons" data-tracer hidden>
      {clients.map((c) => (
        <button type="button" class:list={['trace', c.id === 'agents' && 'trace-agent']} data-client={c.id} data-trace={c.trace} aria-pressed="false">{c.label}</button>
      ))}
    </div>
    <p class="trace-text" role="status" aria-live="polite" data-trace-out>{defaultTrace}</p>
  </div>

  {layouts.map(({ key, l }) => (
    <svg
      class:list={['svg', `svg-${key}`, l.small && 'small']}
      viewBox={`0 0 ${l.w} ${l.h}`}
      role="img"
      aria-labelledby={`${titleId}-${key}`}
      aria-describedby={descId}
      xmlns="http://www.w3.org/2000/svg"
    >
      <title id={`${titleId}-${key}`}>{compact ? 'One engine, many clients (summary)' : 'Cutweave architecture: clients, API layer, engine and outputs'}</title>
      {l.boxes.map((b) => (
        <g>
          <rect class="box" x={b.x} y={b.y} width={b.w} height={b.h} rx="10" />
          <text class="box-label" x={b.lx} y={b.ly}>{b.label}</text>
        </g>
      ))}
      {l.edges.map((e) => (
        <g class:list={['edge-g', e.dashed && 'dashed']} data-paths={e.paths}>
          <path class="edge" d={e.d} />
          {e.head && <polygon class="head" points={headPoints(e.head)} />}
        </g>
      ))}
      {l.labels.map((t) => (
        <text class:list={['elabel', t.mono && 'mono']} x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'} data-paths={t.paths}>{t.text}</text>
      ))}
      {l.nodes.map((n) => (
        <g class:list={['node', `k-${n.kind}`, n.agent && 'agent']} data-paths={n.paths} data-client={n.client}>
          <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="6" />
          <text class="t" x={n.x + n.w / 2} y={titleY(n)} text-anchor="middle">{n.title}</text>
          {n.sub && <text class:list={['s', n.mono && 'mono']} x={n.x + n.w / 2} y={subY(n)} text-anchor="middle">{n.sub}</text>}
        </g>
      ))}
    </svg>
  ))}

  <ul class="legend" aria-label="Legend">
    <li><svg viewBox="0 0 28 16" aria-hidden="true"><rect class="lg-client" x="1" y="2" width="26" height="12" rx="3" /></svg>Client</li>
    <li><svg viewBox="0 0 28 16" aria-hidden="true"><rect class="lg-core" x="1" y="2" width="26" height="12" rx="3" /></svg>Engine component</li>
    <li><svg viewBox="0 0 28 16" aria-hidden="true"><rect class="lg-out" x="1" y="2" width="26" height="12" rx="3" /></svg>Output</li>
    <li><svg viewBox="0 0 28 16" aria-hidden="true"><path class="lg-edge" d="M2 8 H20" /><polygon class="lg-head" points="26,8 20,5 20,11" /></svg>Command or call</li>
    {!compact && <li><svg viewBox="0 0 28 16" aria-hidden="true"><path class="lg-edge lg-dash" d="M2 8 H20" /><polygon class="lg-head" points="26,8 20,5 20,11" /></svg>Events streamed back</li>}
    <li><svg viewBox="0 0 28 16" aria-hidden="true"><rect class="lg-agent" x="1" y="2" width="26" height="12" rx="3" /></svg>Agent path</li>
    <li><svg viewBox="0 0 28 16" aria-hidden="true"><path class="lg-on" d="M2 8 H20" /><polygon class="lg-on-head" points="26,8 20,5 20,11" /></svg>Selected path</li>
  </ul>

  <figcaption class="cap">
    <details id={descId}>
      <summary>Text description of the diagram</summary>
      {compact ? (
        <div class="desc">
          <p>Four clients, the desktop UI, AI agents over MCP, the CLI and plugins, all send commands to one Rust engine through one local API. Inside the engine a command goes to the command bus, then a transaction, then the project document, then the render pipeline. The render pipeline produces three outputs: the preview, an export, and the agent frame.</p>
        </div>
      ) : (
        <div class="desc">
          <p>The diagram has four rows, read top to bottom.</p>
          <ol>
            <li><strong>Clients.</strong> The desktop UI (Electron and React), AI agents over MCP, the cutweave CLI, and plugins (WASM, JS, WGSL and UI panels).</li>
            <li><strong>API layer.</strong> One local axum server on 127.0.0.1 with token auth. It offers JSON-RPC over WebSocket at /rpc, MCP at /mcp, HTTP media endpoints (thumbnails, filmstrips, waveforms, frames), and a shared-memory ring for the preview.</li>
            <li><strong>Engine.</strong> One Rust process. Every client sends commands to the API, then to the command bus, which validates them. The transaction records forward and inverse patches and applies them to the project document, a single writer that holds immutable snapshots. The document feeds the render pipeline and the audio engine. The job manager calls media, AI and render. The plugin host calls the command bus, render and the AI gateway. The AI gateway reaches cloud models over HTTPS. The media layer wraps FFmpeg.</li>
            <li><strong>Outputs.</strong> The render pipeline produces the preview, an export, and the agent frame.</li>
          </ol>
          <p>Events such as doc.patched{`{rev, actor, ops}`} stream from the engine back to every subscriber, and the UI keeps a read-only projection that updates from them.</p>
          {clients.map((c) => <p><strong>{c.label}.</strong> {c.trace.split(': ').slice(1).join(': ')}</p>)}
        </div>
      )}
    </details>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-arch]').forEach((root) => {
    const tracer = root.querySelector<HTMLElement>('[data-tracer]');
    const out = root.querySelector<HTMLElement>('[data-trace-out]');
    if (!tracer || !out) return;
    tracer.hidden = false;
    const fallback = root.dataset.default ?? '';
    const buttons = Array.from(tracer.querySelectorAll<HTMLButtonElement>('[data-client]'));
    const targets = Array.from(root.querySelectorAll<SVGElement>('[data-paths]'));
    const clientNodes = Array.from(root.querySelectorAll<SVGElement>('svg [data-client]'));
    let pinned: string | null = null;

    const apply = (id: string | null) => {
      root.dataset.active = id ?? '';
      if (id) root.setAttribute('data-active', id);
      else root.removeAttribute('data-active');
      targets.forEach((el) => {
        const on = !!id && (el.getAttribute('data-paths') ?? '').split(' ').includes(id);
        el.classList.toggle('on', on);
        el.classList.toggle('dim', !!id && !on);
      });
      const b = buttons.find((x) => x.dataset.client === id);
      out.textContent = b?.dataset.trace ?? fallback;
    };
    const sync = () => buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.client === pinned)));

    buttons.forEach((b) => {
      const id = b.dataset.client ?? null;
      b.addEventListener('click', () => {
        pinned = pinned === id ? null : id;
        sync();
        apply(pinned);
      });
      b.addEventListener('mouseenter', () => apply(id));
      b.addEventListener('focus', () => apply(id));
      b.addEventListener('mouseleave', () => apply(pinned));
      b.addEventListener('blur', () => apply(pinned));
    });
    clientNodes.forEach((n) => {
      const id = n.getAttribute('data-client');
      n.addEventListener('mouseenter', () => apply(id));
      n.addEventListener('mouseleave', () => apply(pinned));
      n.addEventListener('click', () => {
        pinned = pinned === id ? null : id;
        sync();
        apply(pinned);
      });
    });
  });
</script>

