  edges.push(
    { d: 'M150 224 V323', head: [150, 330, 'd'], paths: ALL },
    { d: 'M775 330 V232', head: [775, 225, 'u'], paths: ALL, dashed: true },
    { d: 'M275 358 H338', head: [345, 358, 'r'], paths: ALL },
    { d: 'M575 358 H628', head: [635, 358, 'r'], paths: ALL },
    { d: 'M775 386 V408 H645 V423', head: [645, 430, 'd'], paths: ALL },
    { d: 'M775 408 H830 V423', head: [830, 430, 'd'], paths: 'ui' },
