---
// SPDX-License-Identifier: GPL-3.0-or-later
/**
 * PreviewScene: a calm, abstract interview frame drawn in SVG from design tokens (see area-s1.css).
 * No photography and nothing third-party. Fills its parent; the parent sets the aspect ratio.
 * Props:
 *  - pose?: number   0..5, shifts the figure slightly so contact-sheet frames differ (default 2)
 */
import '../../styles/area-s1.css';

interface Props {
  pose?: number;
}
const { pose = 2 } = Astro.props;
const dx = (pose - 2.5) * 3;
const tilt = (pose % 3) - 1;
---
<div class="cwd-scene" aria-hidden="true">
  <svg viewBox="0 0 160 90" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" focusable="false">
    <circle class="bokeh-a" cx="22" cy="20" r="9" />
    <circle class="bokeh-b" cx="40" cy="34" r="5" />
    <circle class="bokeh-a" cx="132" cy="18" r="7" />
    <circle class="bokeh-b" cx="146" cy="40" r="11" />
    <circle class="bokeh-a" cx="120" cy="52" r="4" />
    <rect class="floor" x="0" y="72" width="160" height="18" />
    <g transform={`translate(${dx} 0)`}>
      <path class="figure" d="M52 90 C52 70 62 63 80 62 C98 63 108 70 108 90 Z" />
      <rect class="figure" x="75" y="52" width="10" height="12" rx="3" />
      <ellipse class="figure" cx="80" cy="40" rx="12" ry="14" transform={`rotate(${tilt * 3} 80 40)`} />
      <path class="rim" d="M68.5 38 C68.5 28 74 25.5 80 25.5" />
      <path class="rim" d="M52.5 90 C52.5 71 62 63.5 74 62.5" />
    </g>
  </svg>
</div>
