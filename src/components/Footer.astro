---
// SPDX-License-Identifier: GPL-3.0-or-later
/**
 * Footer: tagline, three link columns (Product, Open source, Project) and the license note.
 * Props: none (reads SITE, FOOTER_COLUMNS and LINKS from src/site.ts).
 */
import Logo from './Logo.astro';
import Container from './ui/Container.astro';
import { SITE, FOOTER_COLUMNS, LINKS } from '../site';
---
<footer class="footer">
  <Container>
    <div class="grid">
      <div class="about">
        <Logo />
        <p class="tagline">{SITE.tagline}</p>
      </div>
      {FOOTER_COLUMNS.map((col) => (
        <nav class="col" aria-label={col.title}>
          <h2 class="col-title">{col.title}</h2>
          <ul>
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={'external' in link ? '_blank' : undefined}
                  rel={'external' in link ? 'noopener' : undefined}
                >{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <p class="legal">
      Cutweave is free software, licensed under the{' '}
      <a href={LINKS.license} target="_blank" rel="noopener">GNU General Public License v3.0 or later</a>.
      This website is open source too:{' '}
      <a href={LINKS.siteRepo} target="_blank" rel="noopener">view its source</a>.
      It sets no cookies and makes no third-party requests.
    </p>
  </Container>
</footer>

<style>
  .footer {
    margin-top: var(--section-space);
    padding-block: var(--space-12) var(--space-8);
    background: var(--surface-1);
    border-top: var(--border-thin) solid var(--border-subtle);
  }
  .grid { display: grid; gap: var(--space-8); grid-template-columns: 1fr; }
  .about { display: flex; flex-direction: column; gap: var(--space-3); max-width: 36ch; }
  .tagline { color: var(--text-secondary); }
  .col-title {
    margin-bottom: var(--space-3);
    font-size: 12px;
    line-height: 16px;
    font-weight: 650;
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .col ul { display: flex; flex-direction: column; gap: var(--space-1); }
  .col a {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit-min);
    color: var(--text-primary);
    text-decoration: none;
    font-size: 15px;
  }
  .col a:hover { text-decoration: underline; }
  .legal {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: var(--border-thin) solid var(--border-subtle);
    max-width: var(--prose-max);
    color: var(--text-muted);
    font-size: 14px;
    line-height: 22px;
  }
  .legal a { color: var(--text-secondary); }

  @media (min-width: 768px) {
    .grid { grid-template-columns: 1.4fr repeat(3, 1fr); }
  }
</style>
