---
// SPDX-License-Identifier: GPL-3.0-or-later
/**
 * Icon: inline Lucide SVG (24-unit grid, 1.75 stroke, currentColor). No icon font.
 * Props:
 *  - name: IconName       icon to draw (see icons.ts; "github" is the GitHub mark, filled)
 *  - size?: 'sm' | 'md' | 'lg'   icon-sm 14px, icon-md 16px (default), icon-lg 20px
 *  - label?: string       accessible name; omit for decorative icons (aria-hidden)
 *  - class?: string
 */
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: 'sm' | 'md' | 'lg';
  label?: string;
  class?: string;
}
const { name, size = 'md', label, class: className } = Astro.props;

const GITHUB =
  'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z';

const isGithub = name === 'github';
const raw = isGithub ? '' : icons[name as keyof typeof icons];
// Keep only the shapes: drop the license comment and the <svg> wrapper (we draw our own).
const inner = raw
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/^[\s\S]*?<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .trim();
---
<svg
  class:list={['icon', `icon-${size}`, className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox={isGithub ? '0 0 16 16' : '0 0 24 24'}
  fill={isGithub ? 'currentColor' : 'none'}
  stroke={isGithub ? undefined : 'currentColor'}
  stroke-width={isGithub ? undefined : '1.75'}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {isGithub ? <path d={GITHUB} /> : <Fragment set:html={inner} />}
</svg>

<style>
  .icon { flex: none; }
  .icon-sm { width: var(--icon-sm); height: var(--icon-sm); }
  .icon-md { width: var(--icon-md); height: var(--icon-md); }
  .icon-lg { width: var(--icon-lg); height: var(--icon-lg); }
</style>
