---
// SPDX-License-Identifier: GPL-3.0-or-later
/**
 * Container: centers content and applies the page gutters.
 * Props:
 *  - size?: 'default' | 'narrow'   default = --content-max, narrow = --content-narrow
 *  - as?: string                   element to render (default 'div')
 *  - class?: string
 */
interface Props {
  size?: 'default' | 'narrow';
  as?: string;
  class?: string;
}
const { size = 'default', as: Tag = 'div', class: className } = Astro.props;
---
<Tag class:list={['container', `container-${size}`, className]}><slot /></Tag>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .container-default { max-width: calc(var(--content-max) + var(--gutter) * 2); }
  .container-narrow { max-width: calc(var(--content-narrow) + var(--gutter) * 2); }
</style>
