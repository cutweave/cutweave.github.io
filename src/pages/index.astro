---
// SPDX-License-Identifier: GPL-3.0-or-later
// Landing page (docs/site-plan.md section 5, work package S4). One h1 (in HomeHero); every section has an id.
// Sections alternate default and raised tones. Facts: docs/content-inventory.md (status as of product origin/main e129848, 2026-11-26).
// Gaps: GAP-01 and GAP-02 (partly closed by the M1 recording), GAP-03, GAP-09.
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import AgentDemo from '../components/demo/AgentDemo.astro';
import ArchitectureDiagram from '../components/engine/ArchitectureDiagram.astro';
import PluginLayers from '../components/oss/PluginLayers.astro';
import CompareTable from '../components/compare/CompareTable.astro';
import ProofStrip from '../components/roadmap/ProofStrip.astro';
import RoadmapTimeline from '../components/roadmap/RoadmapTimeline.astro';
import HomeHero from '../components/home/HomeHero.astro';
import Pillars from '../components/home/Pillars.astro';
import CreatorVignettes from '../components/home/CreatorVignettes.astro';
import AiLockIn from '../components/home/AiLockIn.astro';
import Faq from '../components/home/Faq.astro';
import RealEditor from '../components/home/RealEditor.astro';
import { LINKS } from '../site';
import { AS_OF, MERGED_P2 } from '../data/roadmap';

// The five most recent merges, newest first, for the roadmap teaser. Order follows the product repo's merge history.
const LATEST_IDS = ['WP-2H.06', 'WP-2A.05', 'WP-2H.03a', 'WP-2C.04', 'WP-2B.01'];
const allMerged = MERGED_P2.flatMap((g) => g.items);
const latest = LATEST_IDS.map((id) => allMerged.find((m) => m.wp === id)).filter((m): m is NonNullable<typeof m> => Boolean(m));
---
<BaseLayout
  description="Cutweave is an open-source video editor for creators and their AI agents, in pre-alpha. Every edit is a command, agents see rendered frames, and there is no account, no watermark and no paywall."
>
  <HomeHero />

  <Section
    id="real-editor"
    eyebrow="The real editor today"
    title="This is the app, recorded by its own test"
    lede="Cutweave imports three clips, cuts them and exports a 1080p MP4. The M1 test drives the real editor, and this recording comes from it. It runs from source on Windows, and there is no download yet."
  >
    <RealEditor stills={false} idPrefix="home" />
    <div class="more"><Button href="/roadmap/#real-editor" iconEnd="arrow-right">See stills and what M1 proved</Button></div>
  </Section>

  <Section
    id="features"
    tone="raised"
    eyebrow="Why Cutweave"
    title="One editor. You and your agent on the same timeline."
  >
    <Pillars />
  </Section>

  <Section
    id="demo"
    eyebrow="Watch it work"
    title="Watch an agent edit"
    lede="A scripted session with real tool names and invented values. Press Accept or Reject at the end."
  >
    <AgentDemo id="home-demo" />
  </Section>

  <Section
    id="creators"
    tone="raised"
    eyebrow="Made for creators"
    title="The workflow you know from CapCut"
    lede="Short-form and long-form, with the tools creators reach for. These are design previews of what is planned, not screenshots of a build."
  >
    <CreatorVignettes />
  </Section>

  <Section
    id="how-it-works"
    eyebrow="How it works"
    title="One engine, many clients"
    lede="The interface, your agent, the command line and plugins all send the same commands to one Rust engine. That is why anything you can do, they can do."
  >
    <ArchitectureDiagram compact idPrefix="home-arch" />
    <div class="more"><Button href="/how-it-works/" iconEnd="arrow-right">See how it works</Button></div>
  </Section>

  <Section
    id="ai"
    tone="raised"
    eyebrow="AI without lock-in"
    title="Your keys. Your models. Your budget."
    lede="Use the leading models without a credits system. Say what it costs before it runs."
  >
    <AiLockIn />
  </Section>

  <Section
    id="plugins"
    eyebrow="Plugins at every layer"
    title="Extend it with data, shaders, TypeScript or WASM"
    lede="Built-in effects use the same interfaces a third party does. A plugin command shows up in the palette, the CLI and MCP on its own."
  >
    <PluginLayers compact cta />
  </Section>

  <Section
    id="compare"
    tone="raised"
    eyebrow="Compared with CapCut"
    title="What changes, and what is not built yet"
    lede="Cutweave is pre-alpha. Every cell on the right shows how far along it is, and built means it exists in the code and is tested on Windows, not that you can install it."
  >
    <CompareTable variant="teaser" headingLevel={3} />
  </Section>

  <Section
    id="proof"
    eyebrow="Proof"
    title="Measured, not promised"
    lede="Tests in the real code, and five Phase 0 prototypes that tested the risky parts first."
  >
    <ProofStrip variant="both" headingLevel={3} />
  </Section>

  <Section
    id="roadmap"
    tone="raised"
    eyebrow="Roadmap"
    title="Phase 2 of 7"
    lede={`The work is in the open. Phase 1 is done: M1 was signed off on ${AS_OF.m1Label}, on Windows. Phase 2 builds the core editor, and ${AS_OF.p2Done} of ${AS_OF.p2Total} work packages are merged.`}
  >
    <RoadmapTimeline compact cta />
    <div class="latest">
      <h3 class="latest-title">Latest merges</h3>
      <ul class="latest-list">
        {latest.map((m) => (
          <li><span class="latest-wp">{m.wp}</span> <span>{m.title}</span></li>
        ))}
      </ul>
      <div class="more"><Button href="/roadmap/#recent" iconEnd="arrow-right">See everything that merged</Button></div>
    </div>
  </Section>

  <Section id="faq" eyebrow="Questions" title="Frequently asked questions">
    <Faq />
  </Section>

  <Section id="follow" tone="raised" align="center" eyebrow="Open source" title="Follow the build" lede="Cutweave is built in public. Star the repository to follow along, or read the architecture to see how it fits together.">
    <div class="close-actions">
      <Button variant="primary" size="lg" href={LINKS.repo} icon="github" external>Follow on GitHub</Button>
      <Button size="lg" href={LINKS.architecture} external iconEnd="external-link">Read the architecture</Button>
    </div>
  </Section>
</BaseLayout>

<style>
  .more { margin-top: var(--stack-lg); }
  .latest { margin-top: var(--space-8); max-width: var(--prose-max); }
  .latest-title { font-size: var(--display-card-size); line-height: 28px; font-weight: 650; margin-bottom: var(--space-3); }
  .latest-list { display: flex; flex-direction: column; gap: var(--space-2); color: var(--text-secondary); }
  .latest-wp { font-family: var(--font-mono); font-size: 13px; color: var(--text-primary); }
  .close-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); }
</style>
