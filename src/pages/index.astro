---
// SPDX-License-Identifier: GPL-3.0-or-later
// Placeholder home page. Another agent replaces the content; keep BaseLayout, a single h1,
// and the #features anchor that the header links to.
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import StatusChip from '../components/ui/StatusChip.astro';
import AgentBadge from '../components/ui/AgentBadge.astro';
import { LINKS } from '../site';
---
<BaseLayout>
  <div class="hero">
    <Container>
      <div class="hero-inner">
        <AgentBadge label="Built for agents" />
        <h1>Edit video with your hands and your agents.</h1>
        <p class="sub">
          Cutweave is an open-source desktop video editor. A fast engine, full MCP control and
          plugins at every layer, with every agent edit visible and reversible.
        </p>
        <div class="cta">
          <Button variant="primary" size="lg" href="/roadmap/" iconEnd="arrow-right">See the roadmap</Button>
          <Button size="lg" href={LINKS.repo} icon="github" external>View source</Button>
        </div>
      </div>
    </Container>
  </div>

  <Section id="features" eyebrow="Features" title="Placeholder content" lede="The home page sections are built by another work package.">
    <ul class="grid">
      <Card as="li">
        <StatusChip status="in-progress" />
        <h3>Headless engine</h3>
        <p>A Rust engine renders the same project in the app, the CLI and for agents.</p>
      </Card>
      <Card as="li">
        <AgentBadge label="Agent edit" size="sm" />
        <h3>Visible agent work</h3>
        <p>Proposals stay pending until you accept them, and history shows who made each edit.</p>
      </Card>
      <Card as="li" href="/open-source/">
        <StatusChip status="planned" />
        <h3>Plugins everywhere</h3>
        <p>Extend effects, panels and models without forking the editor.</p>
      </Card>
    </ul>
  </Section>
</BaseLayout>

<style>
  .hero {
    background: var(--glow-marigold), var(--glow-agent);
    padding-block: var(--section-space);
  }
  .hero-inner { display: flex; flex-direction: column; align-items: flex-start; gap: var(--stack-lg); max-width: 52rem; }
  h1 {
    font-family: var(--font-display);
    font-size: var(--display-hero-size);
    line-height: var(--display-hero-line);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .sub { max-width: var(--prose-max); color: var(--text-secondary); font-size: var(--text-lede-size); line-height: var(--text-lede-line); }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  h3 { font-size: var(--display-card-size); line-height: 1.25; font-weight: 600; }
  .grid p { color: var(--text-secondary); }
</style>
